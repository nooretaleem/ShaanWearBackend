# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Aiven MySQL / MySQL 8+)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED
DATABASE_URL=mysql://avnadmin:PLACEHOLDER_PASSWORD@mysql-shaanwear-db.aivencloud.com:21345/defaultdb?ssl-mode=REQUIRED

# CORS Allowed Origins (Comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500
ADMIN_URL=http://localhost:4200

# Authentication & JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# Cloudinary Product Image Service Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
